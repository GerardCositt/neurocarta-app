APP_NAME="Carta Bar Jaén"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite

# Volcado «Carta Bar v2 - Bar Jaén» (coloca el .sql en database/backups/). Si la BD está vacía, «php artisan setup» lo importa.
# CARTA_IMPORT_SQL=database/backups/carta-bar-jaen-v2.sql

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
# Producción (HTTPS): true
SESSION_SECURE_COOKIE=

# SMTP transaccional (producción: neurocarta.ai)
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=noreply@neurocarta.ai
# MAIL_FROM_NAME="${APP_NAME}"

# OpenAI — necesaria para importar carta con IA, descripciones, imágenes y maridajes.
# Obtén una key en https://platform.openai.com/api-keys
# Alternativa: guardar la key solo para tu restaurante en Ajustes → Importar con IA (no usa créditos de plataforma).
OPENAI_API_KEY=

# Si OPENAI_API_KEY está en .env (clave de plataforma), cada restaurante consume «créditos IA» salvo modo demo ilimitado o key propia del cliente.

# Fotos de la plantilla «Cargar datos de prueba»: URL base (CDN) sin barra final.
# Si está definida, las imágenes de ejemplo apuntan ahí y no se copian al disco del servidor.
# Por defecto la URL es {BASE}/demo/nombre.jpg (igual que DemoContent). Si en el CDN están
# sueltas en la raíz del bucket: NEUROCARTA_TEMPLATE_PRODUCT_IMAGE_FLAT=true
# NEUROCARTA_TEMPLATE_PRODUCT_IMAGE_BASE_URL=https://ejemplo-cdn.neurocarta.ai/menu-template
# NEUROCARTA_TEMPLATE_PRODUCT_IMAGE_FLAT=false

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Stripe secret key (sk_test_... en staging, sk_live_... en producción).
# La publishable key (pk_) no es necesaria con Stripe Checkout alojado.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Price IDs — crear en Stripe Dashboard > Products. Un price por plan/intervalo.
# Importante: estos importes son BASE imponible, sin IVA. En Stripe Tax configura
# "Include tax in prices" / tax_behavior como "exclusive" para que Checkout sume
# el IVA encima y lo desglose correctamente en factura/recibo.
STRIPE_PRICE_BASICO_MONTHLY=
STRIPE_PRICE_BASICO_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_ANNUAL=
